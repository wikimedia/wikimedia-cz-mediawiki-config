{
	"name": "wikimedia-cz/mediawiki-config",
	"description": "MediaWiki config for wikis hosted by Wikimedia Czech Republic",
	"license": "Apache-2.0",
	"require": {
		"php": ">=8.2",
		"ext-curl": "*",
		"symfony/console": "^7.4",
		"symfony/process": "^7.4",
		"symfony/filesystem": "^7.4"
	},
	"require-dev": {
		"jakub-onderka/php-parallel-lint": "1.0.0",
		"php-parallel-lint/php-parallel-lint": "^1.3",
		"phpunit/phpunit": "^11.5"
	},
	"autoload": {
		"psr-4": {
			"WMCZ\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"WMCZ\\Tests\\": "tests/"
		}
	},
	"config": {
		"platform": {
			"php": "8.2.0"
		}
	},
	"scripts": {
		"lint": "parallel-lint --exclude vendor --ignore-fails .",
		"phpunit": "phpunit",
		"test": [
			"composer lint",
			"composer phpunit"
		]
	}
}
